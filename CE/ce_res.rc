#include <windows.h>
#include "ce_resource.h"
#include "ce_app_config.h" /* CE_APP_TITLE_A - see IDD_MAINMENU's CAPTION */

/* App icon (16x16 + 32x32, 32bpp). IDI_MAIN is this file's lowest-numbered
 * (and only) ICON resource, so it is the one the shell shows for
 * AppMain.exe; ce_main.c also puts it on the window class with
 * LoadIconW(IDI_MAIN). Kept next to the mascot in CE/icon/. */
IDI_MAIN ICON "icon/popgba.ico"

/* Touch-to-reveal "menu": plain DialogBoxW + PUSHBUTTON controls (see
 * ce_resource.h for why - this coredll doesn't export SetMenu). English
 * captions only: this .rc is compiled by windres and we have not
 * verified Japanese text survives that pipeline intact on this
 * toolchain, whereas the C-side wide string literals (SetDlgItemTextW
 * etc.) are confirmed working via \x-escaped UTF-16 - keep Japanese
 * strings there, not in resource scripts.
 *
 * Every PUSHBUTTON/DEFPUSHBUTTON/CHECKBOX carries BS_OWNERDRAW and every
 * LISTBOX LBS_OWNERDRAWFIXED | LBS_HASSTRINGS (round: dialog UI overhaul,
 * referencing the sister PopGB & PopSNES ports). The label text is still put on the control the same way -
 * SetDlgItemTextW() from each dialog's ApplyXLanguage() - only the paint
 * path changed: WM_DRAWITEM routes to ce_bmpfont.c's
 * CeBmpFontDrawOwnerButton()/CeBmpFontDrawOwnerCheckbox(), and hidden
 * LTEXTs are repainted from WM_PAINT via CeBmpFontPaintLabel(). This
 * replaces the old jptahoma.ttc + WM_SETFONT scheme (removed for
 * licensing + AddFontResource stability reasons - see ce_lang.h).
 *
 * Layout matches an earlier prototype's IDD_MAINMENU control-for-
 * control (same rects, same 210x140 size): Open ROM full width (WS_GROUP
 * so Up/Down *wrap* at the first/last button), Save/Load State as a 2-up
 * row, the three config dialogs as a 3-up row, Exit full width, and a
 * footer hint line instead of a separate Resume/About button - resuming
 * is just the physical Back key (IDCANCEL). Positioned at 0,0 (screen
 * top-left) with a system "X" close box; tapping it delivers IDCANCEL
 * the same way the physical Back key does.
 *
 * Round 64: pastel/rounded skin + Screenshot button ported from the
 * sister PopGB - Video/Sound/Input row grown to 34 for an
 * icon-over-label layout, Exit split into a Screenshot | Exit 2-up row,
 * dialog 140->154. Colors, RoundRect() drawing and the mascot blit live
 * in ce_main.c's MainMenuDlgProc (kMainMenuTheme, WM_ERASEBKGND,
 * WM_PAINT). */
IDD_MAINMENU DIALOG 0, 0, 210, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
/* CE_APP_TITLE_A (ce_app_config.h), not a literal - windres runs .rc
 * files through cpp (the #include lines above already prove that), so
 * the macro expands here exactly as if hand-typed, and a new port only
 * edits ce_app_config.h. Was left as the template's own placeholder
 * text through round 16 (spotted in a real-hardware screenshot). */
CAPTION CE_APP_TITLE_A
FONT 9, "Tahoma"
BEGIN
    PUSHBUTTON "Open ROM...", IDC_MM_OPEN,       8,  8, 194, 20, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Save State",  IDC_MM_SAVESTATE,  8, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Load State",  IDC_MM_LOADSTATE, 109, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Video Cfg",   IDC_MM_VIDEO,      8, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Sound Cfg",   IDC_MM_SOUND,     75, 56,  60, 34, BS_OWNERDRAW
    PUSHBUTTON "Input Cfg",   IDC_MM_INPUT,    143, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Screenshot",  IDC_MM_SCREENSHOT, 8, 94,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Exit",        IDC_MM_EXIT,     109, 94,  93, 20, BS_OWNERDRAW
    LTEXT "Press Back to resume the game.", IDC_MM_HINT, 8, 122, 194, 20
END

/* Main-menu mascot art (ce_main.c's MainMenuDlgProc WM_PAINT). */
IDB_MAINMENU BITMAP "icon/popgba_mascot.bmp"

/* Two columns of label + remap-button pairs, plus a footer OK row - see
 * ce_input.c for the remap-by-press logic and ce_resource.h for why
 * this is a plain DialogBox.
 *
 * GBA has only A/B/L/R (no X/Y - unlike the sister Genesis/SNES CE
 * ports' 6-button right column) mapping directly to the identically-
 * named RETRO_DEVICE_ID_JOYPAD_* ids. Left column: Up/Down/Left/Right
 * then the four diagonal D-pad combo rows (UpRight/RightDown/DownLeft/
 * LeftUp - see ce_input.c's s_map[]). Right column: A/B/L/R at the top,
 * then a blank spacer row, then Select/Start - the left column's
 * now-taller 8 rows just run past the right column's 7, which is fine
 * since it's two independent columns, not a shared grid.
 *
 * Row spacing 18 DLU. Dialog was 190x176 (real-hardware-verified in
 * earlier rounds) but the OK row's bottom edge came out clipped below
 * the visible client area on this device, so every control's y was
 * shifted up 4 DLU and the dialog height trimmed 176 -> 172 to match
 * (user request). Earlier rounds add BS_OWNERDRAW to every
 * PUSHBUTTON and real control IDs to the previously-anonymous ("-1")
 * A/B/L/R and diagonal-combo LTEXTs (IDC_IC_LBL_A etc., ce_resource.h)
 * so WM_PAINT's CeBmpFontPaintLabel() can find them - in English they
 * keep this .rc text, in Japanese ApplyInputConfigLanguage (ce_input.c)
 * re-sets them to full-width A/B/L/R and the up-right/right-down/
 * down-left/left-up kanji pairs. WS_GROUP on the first remap button
 * makes Up/Down wrap through OK and back. No Cancel button - the
 * physical Back key (IDCANCEL) commits like OK. */
IDD_INPUTCONFIG DIALOG 0, 0, 190, 172
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Config"
FONT 9, "Tahoma"
BEGIN
    /* 2026-09-27 (PopPCE と同じ変更): remap buttons widened to 54 - the
     * Galmuri14 font's "Press key"/"Backspace" overflowed 48 on real
     * hardware (PopPCE). The dialog width is unchanged; the gaps between
     * the columns and the right margin were narrowed instead. */
    LTEXT     "Up",       IDC_IC_LBL_UP,    6,  8, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UP,   40,  7, 54, 14, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    LTEXT     "A",        IDC_IC_LBL_A,   98,  8, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_A,   132,  7, 54, 14, BS_OWNERDRAW

    LTEXT     "Down",     IDC_IC_LBL_DOWN,  6, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWN, 40, 25, 54, 14, BS_OWNERDRAW
    LTEXT     "B",        IDC_IC_LBL_B,   98, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_B,   132, 25, 54, 14, BS_OWNERDRAW

    LTEXT     "Left",     IDC_IC_LBL_LEFT,  6, 44, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFT, 40, 43, 54, 14, BS_OWNERDRAW
    LTEXT     "L",        IDC_IC_LBL_L,   98, 44, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_L,   132, 43, 54, 14, BS_OWNERDRAW

    LTEXT     "Right",    IDC_IC_LBL_RIGHT, 6, 62, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHT,40, 61, 54, 14, BS_OWNERDRAW
    LTEXT     "R",        IDC_IC_LBL_R,   98, 62, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_R,   132, 61, 54, 14, BS_OWNERDRAW

    /* Row at y=78 (right column) is a deliberate blank spacer
     * separating Select/Start below from A/B/L/R above - no controls
     * there. The left column keeps going with the four diagonal combo
     * rows instead. */
    LTEXT     "Up R",     IDC_IC_LBL_UPRIGHT,   6, 80, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UPRIGHT,  40, 79, 54, 14, BS_OWNERDRAW
    LTEXT     "R Down",   IDC_IC_LBL_RIGHTDOWN, 6, 98, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHTDOWN,40, 97, 54, 14, BS_OWNERDRAW
    LTEXT     "Down L",   IDC_IC_LBL_DOWNLEFT,  6,116, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWNLEFT, 40,115, 54, 14, BS_OWNERDRAW
    LTEXT     "L Up",     IDC_IC_LBL_LEFTUP,    6,134, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFTUP,   40,133, 54, 14, BS_OWNERDRAW

    /* Select/Start captions ("セレクト"/"スタート") run wider than the
     * single-word English or single-kanji labels above, so these rows'
     * label boxes stay wider than the uniform 32-width; the remap
     * buttons still match every other row (48x14, x=138). */
    LTEXT     "Select",   IDC_IC_LBL_SELECT, 98, 98, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_SELECT,132, 97, 54, 14, BS_OWNERDRAW

    LTEXT     "Start",    IDC_IC_LBL_START,  98,116, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_START, 132,115, 54, 14, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",                IDOK,          70, 152,  50, 14, BS_OWNERDRAW
END

/* Volume/Rate/Bits/Quality/Buffer "-/value/+" spinners - the value
 * lives on a WS_TABSTOP PUSHBUTTON in the middle so it gets a focus
 * rectangle and a place in the physical-key Up/Down/Left/Right loop (see
 * ce_audio.c's SoundConfigDlgProc/SoundCtrlProc); the "-"/"+" buttons
 * are touch-only (no WS_TABSTOP). No Cancel button: the physical Back
 * key (IDCANCEL) commits and closes exactly like OK. All five rows' "-"
 * buttons share x=53 and all five value buttons share x=68 so the
 * spinner columns line up regardless of caption width. The "Buffer:"
 * row (ce_audio.c ring size) was added this round, growing the dialog
 * 104 -> 121 and moving OK 86 -> 103 (ported from the sister PopGB /
 * PopSNES ports). Every button carries BS_OWNERDRAW - see
 * ce_bmpfont.c. */
IDD_SOUNDCONFIG DIALOG 0, 0, 190, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "Volume:",  IDC_SC_LBL_VOLUME,     8,  9, 44,  8
    PUSHBUTTON "-",        IDC_SC_VOLUME_MINUS,  53,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "10",       IDC_SC_VOLUME_VALUE,  68,  6, 20, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_VOLUME_PLUS,   89,  7, 14, 12, BS_OWNERDRAW

    LTEXT      "Rate:",    IDC_SC_LBL_RATE,       8, 26, 30,  8
    PUSHBUTTON "-",        IDC_SC_RATE_MINUS,    53, 24, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Native",   IDC_SC_RATE_VALUE,    68, 23, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_RATE_PLUS,    129, 24, 14, 12, BS_OWNERDRAW

    LTEXT      "Bits:",    IDC_SC_LBL_BITS,       8, 42, 30, 10
    PUSHBUTTON "-",        IDC_SC_BITS_MINUS,    53, 41, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16-bit",   IDC_SC_BITS_VALUE,    68, 40, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BITS_PLUS,    132, 41, 14, 12, BS_OWNERDRAW

    LTEXT      "Quality:", IDC_SC_LBL_QUALITY,    8, 59, 34, 10
    PUSHBUTTON "-",        IDC_SC_QUALITY_MINUS, 53, 58, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Smooth",   IDC_SC_QUALITY_VALUE, 68, 57, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_QUALITY_PLUS, 132, 58, 14, 12, BS_OWNERDRAW

    LTEXT      "Buffer:",  IDC_SC_LBL_BUFFER,     8, 76, 34, 10
    PUSHBUTTON "-",        IDC_SC_BUFFER_MINUS,  53, 75, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Default",  IDC_SC_BUFFER_VALUE,  68, 74, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BUFFER_PLUS,  132, 75, 14, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",    IDOK,                  70, 103, 50, 14, BS_OWNERDRAW
END

/* Scale (see CeScaleMode in ce_video.h), Color Correction, Frame Skip
 * ("-/value/+" spinner), the English/Japanese toggle (also a
 * "-/value/+" spinner), Open Last Folder (ce_fileopen.c), and Enable
 * Debug Log (ce_log.c's CeLogSetEnabled(), added this round). No Cancel
 * button - see IDD_SOUNDCONFIG's comment. Width 190 like every other
 * settings/picker dialog. The "Enable Debug Log" checkbox grew the
 * dialog 116 -> 132 and moved OK 92 -> 108. Every PUSHBUTTON/CHECKBOX
 * carries BS_OWNERDRAW; "Scale:" now has a real ID (IDC_VC_LBL_SCALE)
 * instead of "-1" so WM_PAINT's CeBmpFontPaintLabel() can find it,
 * even though it's never translated.
 *
 * BS_OWNERDRAW on a CHECKBOX collides with BS_CHECKBOX in the same style
 * field (both live in the low bits windres treats as one button-type
 * value) and silently breaks BM_GETCHECK/BM_SETCHECK - real-hardware
 * lesson from the sister ports. ce_video.c
 * keeps its own bool for each checkbox (s_colorCorrection /
 * CeLogIsEnabled()) as the source of
 * truth and paints box+check itself from WM_DRAWITEM via
 * CeBmpFontDrawOwnerCheckbox(). */
IDD_VIDEOCONFIG DIALOG 0, 0, 190, 116
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT       "Scale:",       IDC_VC_LBL_SCALE,       8,  9, 30,  8
    PUSHBUTTON  "-",            IDC_VC_SCALE_MINUS,     45,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON  "x1",           IDC_VC_SCALE_VALUE,     60,  6, 40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_SCALE_PLUS,      101,  7, 14, 12, BS_OWNERDRAW

    CHECKBOX    "Color Correction", IDC_VC_COLORCORRECT,  8, 24, 160, 12, BS_OWNERDRAW

    LTEXT       "Frame Skip:",  IDC_VC_LBL_FRAMESKIP,   8, 42,  90, 12
    PUSHBUTTON  "-",            IDC_VC_FRAMESKIP_DOWN, 100, 40,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "Off",          IDC_VC_FRAMESKIP_LABEL,116, 39,  26, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_FRAMESKIP_UP,   144, 40,  14, 12, BS_OWNERDRAW

    /* This row's "-/value/+" group is centred within the dialog's own
     * 190 width - it has no leading caption of its own to align under.
     * IDC_VC_JAPANESE shows the real "日本語"/"English" drawn by the
     * Shinonome font from WM_DRAWITEM (ce_video.c's UpdateLanguageLabel). */
    PUSHBUTTON  "-",              IDC_VC_LANG_MINUS,      34, 61,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "English",        IDC_VC_JAPANESE,        50, 60,  90, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",              IDC_VC_LANG_PLUS,      142, 61,  14, 12, BS_OWNERDRAW

    /* Round 64: the "Open Last Folder" checkbox was removed (user
     * request) - the picker now always reopens the last ROM's folder
     * (ce_fileopen.c). Debug Log / OK moved up 16 DLU, dialog 132->116. */
    CHECKBOX    "Enable Debug Log", IDC_VC_DEBUGLOG,      8, 74, 174, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,                          70, 92, 50, 14, BS_OWNERDRAW
END

/* Custom ROM picker (see ce_fileopen.c) - replaces GetOpenFileNameW().
 * Folder-list + up-navigation ("<" as the first entry) only, driven by
 * the physical direction keys and the decide/cancel keys. 190x104 like
 * every settings dialog. IDC_FO_LIST carries LBS_OWNERDRAWFIXED |
 * LBS_HASSTRINGS so ROM/directory names with Japanese characters draw
 * with the Shinonome bitmap font (ce_fileopen.c's WM_MEASUREITEM/
 * WM_DRAWITEM) instead of tofu-ing under a TrueType face that no longer
 * exists. LBS_HASSTRINGS is required alongside LBS_OWNERDRAWFIXED -
 * without it an owner-draw listbox does NOT retain the LB_ADDSTRING
 * strings and LB_GETTEXT comes back empty (real-hardware-confirmed by
 * the sister ports). Listbox height 64 (trimmed from 66 - at 66 the
 * last visible row came out partially clipped on real hardware). */
IDD_FILEOPEN DIALOG 0, 0, 190, 108
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select ROM"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_FO_PATH, 6, 4, 178, 10
    /* 2026-09-27 (PopPCE と同じ変更): list 64 -> 68, dialog 104 -> 108,
     * OK 86 -> 90 - with the Galmuri14 font's 19px rows the 6th row came
     * out cut off on real hardware (PopPCE). */
    LISTBOX               IDC_FO_LIST, 6, 16, 178, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",   IDOK,        70, 90, 50, 14, BS_OWNERDRAW
END

/* Generic message box (see ce_resource.h's IDD_MSGBOX comment and
 * ce_main.c's CeShowMsgBox()/MsgBoxDlgProc) - ported from the sister
 * PopGB / PopSNES projects. Draws its text itself with the
 * Shinonome bitmap font (MessageBoxW() has no Japanese glyphs on this
 * device any more - jptahoma.ttc removed). IDC_MB_TEXT starts empty and
 * is filled in / wrapped onto up to CE_MSGBOX_MAX_LINES lines as needed
 * by MsgBoxDlgProc's WM_PAINT. Widened to 200x64 so the longer non-ASCII
 * path rejection message (RejectNonAsciiPathAndExit()) fits. */
IDD_MSGBOX DIALOG 0, 0, 200, 64
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION CE_APP_TITLE_A
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",     IDC_MB_TEXT, 8, 5, 184, 38
    DEFPUSHBUTTON "OK", IDOK,       75, 44, 50, 14, BS_OWNERDRAW
END

/* Yes/No confirmation (user request - Save State asks first). Same
 * self-drawn Shinonome-bitmap-font design as IDD_MSGBOX above; two
 * BS_OWNERDRAW buttons with custom IDs (IDC_CF_YES/IDC_CF_NO) drawn and
 * key-handled by ce_main.c's ConfirmDlgProc/ConfirmBtnCtrlProc. */
IDD_CONFIRM DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION CE_APP_TITLE_A
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_CF_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "Yes", IDC_CF_YES, 18, 48, 45, 14, BS_OWNERDRAW
    PUSHBUTTON    "No",  IDC_CF_NO,  71, 48, 45, 14, BS_OWNERDRAW
END
